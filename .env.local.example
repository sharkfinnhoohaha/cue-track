# =============================================================================
# Cue Track .env.local example
# =============================================================================
# Copy to .env.local and fill in. On Vercel, set the same names via
# `vercel env add NAME production`. The build does NOT need any of these set;
# they gate the runtime flows (auth, payment, generate, etc.).
# =============================================================================

# --- Database (required for all DB-backed routes) ----------------------------
# Neon pooled connection string (required for serverless; direct connections
# exhaust under load). Free tier is fine for V1.
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Auth (required for /api/auth/*) -----------------------------------------
NEXTAUTH_SECRET=run-openssl-rand-base64-32-and-paste-here
# Local dev:
NEXTAUTH_URL=http://localhost:3000
# Production set on Vercel:
#   NEXTAUTH_URL=https://cue-track-sharkfinnhoohahas-projects.vercel.app

# --- Site URL (used by metadata, sitemap.ts, robots.ts, OG image) ------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Cloud TTS (optional; tone-cue fallback works without) ------------
# Preferred on Vercel (ephemeral filesystem makes file-path auth painful):
GOOGLE_TTS_API_KEY=AIzaSy...
# Local dev alternative (service account JSON file path):
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Stripe (TEST MODE for V1; flip-to-live is Finn's action) ----------------
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get from https://dashboard.stripe.com/test/webhooks after creating an endpoint
# pointing at https://<your-vercel-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Create a product + recurring price for Pro and one-time price for Single,
# then paste the price IDs (price_XXX) here. Code reads these exact names:
STRIPE_SINGLE_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# --- Resend (optional for V1; magic-link email auth) -------------------------
# V1 minimal-provisioning path skips this; checkout+session_id polling covers
# the auth equivalent. Set if/when magic-link email is wired in.
RESEND_API_KEY=re_...
EMAIL_FROM=hello@cuetrack.app

# --- Sentry (optional; DSN-gated, silent no-op when unset) -------------------
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# Source-map upload at build time (silent without):
# SENTRY_AUTH_TOKEN=sntrys_...
# Suppress the build-time "no global error handler" warning if needed:
# SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1

# --- Cloud Run audio worker (deploy-ready at services/audio-worker/) ---------
# Wired into /api/tracks/[id]/download: when AUDIO_WORKER_URL is set, full-
# track renders whose duration is at or above AUDIO_WORKER_THRESHOLD_SECONDS
# (default 240) offload to the worker via POST /render with the shared
# secret on the X-Worker-Secret header. Worker auth (X-Worker-Secret)
# matches WORKER_SHARED_SECRET on the Cloud Run side. Previews always
# render in-process regardless.
#
# With AUDIO_WORKER_URL unset (current production state), behavior is
# byte-identical to pre-Phase-4: everything renders in-process.
# AUDIO_WORKER_URL=https://audio-worker-xxx.run.app
# AUDIO_WORKER_SHARED_SECRET=...
# AUDIO_WORKER_THRESHOLD_SECONDS=240

# --- Track generation limits -------------------------------------------------
# Server-side cap on generated-track duration in seconds. Defaults to 1800
# (30 minutes) when unset. The frontend reads NEXT_PUBLIC_MAX_TRACK_DURATION_
# SECONDS for the inline warning; keep the two values in sync.
# MAX_TRACK_DURATION_SECONDS=1800
# NEXT_PUBLIC_MAX_TRACK_DURATION_SECONDS=1800

# --- TTS strict mode ---------------------------------------------------------
# When strict, the synthesizer refuses to fall back to beep-tone substitution
# if Google Cloud TTS credentials are missing. Set TTS_STRICT=true to force
# strict mode, TTS_STRICT=false to force fallback. Default behavior: strict
# in production (NODE_ENV=production), permissive in dev so local work
# without credentials still functions. Without strict mode, an unconfigured
# Vercel deploy silently ships tracks full of beep tones.
# TTS_STRICT=true

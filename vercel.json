{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/tracks/generate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/demo-preview/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup-rate-limits",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/demo-preview",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, immutable"
        }
      ]
    }
  ]
}
